{
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "swagger": "2.0",
    "info": {
        "description": "no description",
        "title": "Foodx API Documentation",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/account": {
            "get": {
                "security": [
                    {
                        "access_token": []
                    }
                ],
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/account_usecase.AuthOutput"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httphelper.HttpError"
                        }
                    }
                }
            },
            "patch": {
                "tags": [
                    "Account"
                ],
                "parameters": [
                    {
                        "description": "update input data",
                        "name": "customer",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/account_handler.updateReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httphelper.HttpError"
                        }
                    }
                }
            }
        },
        "/account/login": {
            "post": {
                "tags": [
                    "Account"
                ],
                "parameters": [
                    {
                        "description": "login input data",
                        "name": "customer",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/account_handler.loginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/account_usecase.AuthOutput"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httphelper.HttpError"
                        }
                    }
                }
            }
        },
        "/account/logout": {
            "post": {
                "security": [
                    {
                        "access_token": []
                    }
                ],
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/password": {
            "patch": {
                "tags": [
                    "Account"
                ],
                "parameters": [
                    {
                        "description": "change password data",
                        "name": "customer",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/account_handler.changePasswordReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/account_usecase.AuthOutput"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httphelper.HttpError"
                        }
                    }
                }
            }
        },
        "/projects": {
            "post": {
                "tags": [
                    "Projects"
                ],
                "parameters": [
                    {
                        "description": "add project data",
                        "name": "project",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/projects_handler.addReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httphelper.HttpError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "account_handler.changePasswordReq": {
            "type": "object",
            "required": [
                "new_password",
                "old_password"
            ],
            "properties": {
                "clear_session": {
                    "type": "boolean",
                    "example": false
                },
                "new_password": {
                    "type": "string",
                    "example": "QcU+,317QL[t"
                },
                "old_password": {
                    "type": "string",
                    "example": "badboy2015"
                }
            }
        },
        "account_handler.loginReq": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "user@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "qwerty123"
                }
            }
        },
        "account_handler.updateReq": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "John Doe"
                }
            }
        },
        "account_usecase.AuthOutput": {
            "type": "object",
            "properties": {
                "customer": {
                    "$ref": "#/definitions/account_usecase.Customer"
                },
                "subscription": {
                    "$ref": "#/definitions/account_usecase.Subscription"
                }
            }
        },
        "account_usecase.Customer": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "account_usecase.Subscription": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                }
            }
        },
        "httphelper.HttpError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                }
            }
        },
        "projects_handler.addReq": {
            "type": "object",
            "required": [
                "background",
                "description",
                "languages",
                "logo",
                "name",
                "service_fee"
            ],
            "properties": {
                "background": {
                    "type": "string",
                    "example": "aGVsbG8gd29ybGQ="
                },
                "description": {
                    "type": "string",
                    "example": "The Best Restaurant in the City."
                },
                "languages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "kz",
                        "en"
                    ]
                },
                "logo": {
                    "type": "string",
                    "example": "aGVsbG8gd29ybGQ="
                },
                "name": {
                    "type": "string",
                    "example": "Burger Queen"
                },
                "service_fee": {
                    "type": "integer",
                    "example": 10
                }
            }
        }
    }
}